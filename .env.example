# Set to "true" to preview the dashboard with generated sample data instead
# of your real entries. Takes priority over the Supabase vars below.
VITE_USE_DUMMY_DATA=false

# Leave both blank to use browser local storage (no setup needed).
# Set both, then restart the dev server / redeploy, to switch to Supabase.
# See supabase/schema.sql for the table this app expects, and
# SUPABASE_DEPLOY_GUIDE.md for step-by-step setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
